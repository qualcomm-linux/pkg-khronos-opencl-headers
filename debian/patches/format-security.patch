Author: Andreas Beckmann <anbe@debian.org>
Description: disable -Werror=format-security
 clashes with -Wno-format

--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -24,7 +24,7 @@ function(add_header_test NAME SOURCE)
     endif()
     target_compile_options(${TEST_EXE}
       PUBLIC
-        $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Werror -pedantic -Wno-format>
+        $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Werror -pedantic -Wno-format -Wno-error=format-security>
         $<$<CXX_COMPILER_ID:MSVC>:${MSVC_COMPILE_DEFS}>
     )
     add_test(NAME ${TEST_EXE} COMMAND ${TEST_EXE})
